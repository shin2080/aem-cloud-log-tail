# ── 서버 ──────────────────────────────────────────
PORT=7300

# 이 기기 밖에서 접근하게 하려면 바꾼다. 바꾸기 전에 README '외부 접근' 을 읽는다.
#   127.0.0.1  이 기기에서만 (기본, 가장 안전)
#   100.x.x.x  Tailscale 주소 — 본인 기기에서만, 인터넷 노출 없음 (권장)
#   0.0.0.0    같은 네트워크 전체에 공개
HOST=127.0.0.1
DATABASE_PATH=./data/app.db
SESSION_SECRET=                    # openssl rand -hex 32
# 유휴 기준. 쓰는 동안에는 계속 연장된다 (화면이 10분마다 서버를 두드린다).
# 아무도 안 건드리면 이 시간 뒤에 로그인이 풀린다.
SESSION_TTL_HOURS=12
# 연장의 천장. 처음 로그인한 뒤 이만큼 지나면 쓰고 있어도 다시 로그인해야 한다.
# 모니터에 상시로 띄워둔다면 이 값이 곧 '사람이 가서 로그인해야 하는 주기' 다.
SESSION_MAX_HOURS=168
SESSION_COOKIE_SECURE=false        # HTTPS 뒤에서 돌릴 때만 true
TRUST_PROXY=false                  # 리버스 프록시/터널 뒤에 둘 때만 true

# ── 최초 관리자 (첫 부팅 때만 사용) ─────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=            # 8자 이상. 최초 로그인 후 변경 강제

# ── 버퍼 / 안전장치 ────────────────────────────────
# 로그가 blob 으로 flush 되는 주기가 약 60초다. 더 자주 폴링해도 416만 돌아온다.
TAIL_POLL_INTERVAL_MS=20000
TAIL_INITIAL_BYTES=262144          # 최초 진입 시 파일 끝에서 읽어올 바이트
TAIL_BUFFER_MAX_LINES=50000        # 세션당 링버퍼 라인 수
TAIL_BUFFER_MAX_BYTES=134217728    # 세션당 128MB
TAIL_IDLE_TIMEOUT_MS=300000        # 구독자 0명이 5분 지나면 세션 종료
SEARCH_MAX_RESULT_LINES=200000
EXPORT_MAX_BYTES=524288000         # 500MB
MASKING_ENABLED=true
AUDIT_RETENTION_DAYS=365           # 감사 기록 보존. 0이면 영구 (삭제 API 는 없다)

# ── 조직 레지스트리 ────────────────────────────────
# ORG_{n}_ 접두어를 1부터 순번대로 스캔한다.
# ORG_{n}_LABEL 이 없으면 스캔을 멈춘다.
#
# ORG_n_KEY 는 DB의 user_orgs.org_key 와 조인되는 값이다.
# 한 번 정하면 바꾸지 않는다. 바꾸면 기존 계정의 조직 접근 권한이 끊긴다.
ORG_1_KEY=acme                     # URL·DB에서 쓰는 안정적 식별자 (소문자, 영숫자/하이픈)
ORG_1_LABEL=ACME 코퍼레이션
ORG_1_IMS_ORG_ID=XXXXXXXXXXXX@AdobeOrg
ORG_1_CLIENT_ID=
ORG_1_CLIENT_SECRET=
ORG_1_SCOPES=                      # Developer Console에 표시된 scope 문자열을 그대로 복사

ORG_2_KEY=globex
ORG_2_LABEL=Globex
ORG_2_IMS_ORG_ID=
ORG_2_CLIENT_ID=
ORG_2_CLIENT_SECRET=
ORG_2_SCOPES=
